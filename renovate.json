{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base", ":semanticCommits", ":gitSignOff", "helpers:pinGitHubActionDigests"],
  "timezone": "Europe/Berlin",
  "schedule": ["every weekend"],
  "labels": ["dependencies", "3. to review"],
  "rangeStrategy": "bump",
  "minimumReleaseAge": "7 days",
  "rebaseWhen": "conflicted",
  "ignoreUnstable": true,
  "baseBranches": ["main", "stable1.0"],
  "useBaseBranchConfig": "merge",
  "enabledManagers": ["npm", "composer", "github-actions"],
  "ignoreDeps": ["node", "npm"],
  "packageRules": [
    {
      "description": "Stable branches: no major updates",
      "matchBaseBranches": ["/^stable/"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Stable branches: dev dependencies get patch updates only",
      "matchBaseBranches": ["/^stable/"],
      "matchDepTypes": ["devDependencies", "require-dev"],
      "matchUpdateTypes": ["minor"],
      "matchJsonata": ["$not($exists(vulnerabilityFixVersion))"],
      "enabled": false
    },
    {
      "description": "Request JavaScript reviews",
      "matchManagers": ["npm"],
      "reviewers": ["enjeck"]
    },
    {
      "description": "Request PHP reviews",
      "matchManagers": ["composer"],
      "reviewers": ["blizzz"]
    },
    {
      "description": "Request maintainer reviews",
      "matchManagers": ["github-actions"],
      "extends": ["schedule:monthly"],
      "reviewers": ["enjeck", "blizzz"]
    },
    {
      "groupName": "tiptap",
      "matchPackagePrefixes": ["@tiptap/", "prosemirror-"]
    },
    {
      "matchBaseBranches": ["/^stable1.0$/"],
      "matchPackageNames": ["@nextcloud/files"],
      "allowedVersions": "<4"
    },
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7",
      "description": "Hold back TypeScript 7 (native Go port) until vue-tsc supports it"
    },
    {
      "groupName": "cypress",
      "matchPackageNames": ["cypress", "@nextcloud/cypress"],
      "matchPackagePrefixes": ["@cypress/"]
    }
  ]
}
